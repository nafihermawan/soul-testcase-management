# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Supabase (produksi): pakai TRANSACTION pooler untuk runtime aplikasi.
#   - 6543 = transaction pooler (Supavisor) -> DATABASE_URL
#   - 5432 = session pooler / direct      -> DIRECT_DATABASE_URL (khusus Prisma CLI)
# Transaction pooler tidak mendukung DDL, jadi migrasi WAJIB lewat 5432.
# Pooler membatasi jumlah client (di proyek ini pool_size 15), karena itu
# max pool di lib/prisma.ts dijaga kecil (3).
# Kalau muncul error `prepared statement "..." already exists` saat load naik,
# baru pertimbangkan menambah `?pgbouncer=true` (lihat docs Prisma: untuk
# PgBouncer >= 1.21.0 justru disarankan TIDAK memakainya).
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/soul_testcase?schema=public"

# Koneksi langsung/session untuk Prisma CLI & migrasi (dibaca prisma.config.ts).
# Di Supabase arahkan ke port 5432. Kalau kosong, Prisma CLI jatuh ke DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/soul_testcase?schema=public"

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 — storage attachment (evidence gambar/video)
# Dashboard > R2 > Overview (Account ID) dan R2 > Manage API Tokens (Access Key).
# WAJIB: set CORS policy bucket agar browser bisa upload:
#   [{"AllowedOrigins":["http://localhost:3000","https://<domain-vercel>"],
#     "AllowedMethods":["PUT","GET"],"AllowedHeaders":["content-type"],"MaxAgeSeconds":3600}]
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="soul-tcm-attachments"
